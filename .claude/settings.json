{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(../golden-dataset/**)",
      "Read(//c/Users/luca_/Desktop/golden-dataset/**)",
      "Read(./.golden-data/**)",
      "Edit(../golden-dataset/**)",
      "Edit(//c/Users/luca_/Desktop/golden-dataset/**)",
      "Bash(*golden-dataset*)",
      "Bash(*.golden-data*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.github/hooks/protect-owned-files.cjs\"" }
        ]
      }
    ]
  }
}
