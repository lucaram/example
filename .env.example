# Copy to .env (never commit .env). Free Groq key: https://console.groq.com/keys
GROQ_API_KEY=

# live = call Groq, mock = deterministic fake (tests, e2e, CI)
LLM_MODE=mock

# App generator and judge come from different model families on purpose.
# Check current free model ids with: npm run llm:models (see scripts/list-models.mjs)
LLM_MODEL=qwen/qwen3.8-27b
JUDGE_MODEL=openai/gpt-oss-120b

# Where the golden dataset repo is cloned (outside this repo, agents must not read it)
GOLDEN_DIR=../golden-dataset
